---
import '../styles/global.css';
import fontUrl from '../assets/fonts/archivo-latin-wdth-normal.woff2?url';
import Analytics from '../components/Analytics.astro';
const {
  title = 'SNAPSBYROSA — Birthday portraits and content, The Hague',
  description = 'Photos and short clips for the days you want to keep. Birthday portraits and content, shot and edited by Jeremy Rosa in The Hague.',
  path = '/',
  theme = 'dark',
} = Astro.props;
const site = 'https://snapsbyrosa.com';
const canonical = site + path;
// Social-share image: plain file in /public so scrapers get a stable URL.
const ogImage = `${site}/img/og-cover.jpg`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${site}/#business`,
  name: 'SNAPSBYROSA',
  description,
  url: site + '/',
  image: ogImage,
  email: 'info@snapsbyrosa.com',
  telephone: '+31641592658',
  sameAs: ['https://instagram.com/snapsbyrosa'],
  foundingDate: '2024',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'The Hague',
    addressRegion: 'South Holland',
    addressCountry: 'NL',
  },
  areaServed: ['The Hague', 'Netherlands'],
  founder: { '@type': 'Person', name: 'Jeremy Jordan Rosa', jobTitle: 'Photographer and videographer' },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Sessions',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Birthday portraits' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Content: photos and short clips' } },
    ],
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="SNAPSBYROSA" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#17130f" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />

    <meta property="og:site_name" content="SNAPSBYROSA" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class={theme === 'light' ? 'theme-light' : ''}>
    <slot />
    <Analytics />
  </body>
</html>
