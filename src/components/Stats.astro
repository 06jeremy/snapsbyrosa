---
// Value tiles — HONEST premium positioning (no numbers). The dark panel closes
// the Work→Stats block before About (cream).
//
// NOTE(real-content): these are qualitative "how I work" statements, not metrics.
// Once REAL numbers are confirmed (views generated, clients photographed,
// turnaround time, rebook rate), you can swap this back to a count-up stat grid
// — the count-up JS (main.js initStats, keyed off `data-count-to`) is still in
// place and will animate automatically if you re-add those attributes. Do NOT
// publish invented metrics.
const values = [
  { k: 'Photo + video', label: 'One shoot gives you both the stills and the short-form edits.' },
  { k: 'Story first', label: 'Direction on the day, so it feels like you — not staged, not stock.' },
  { k: 'Made for the feed', label: 'Content that works on your site and across social.' },
  { k: 'The Hague · worldwide', label: 'Based in The Hague since 2024, working wherever you need me.' },
];
---
<section class="stats" aria-label="How we work">
  <div class="container">
    <div class="stats__grid">
      {values.map((v) => (
        <div class="stat reveal">
          <div class="stat__num condensed">{v.k}</div>
          <p class="stat__label">{v.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .stats {
    background: var(--dark-bg);
    color: var(--dark-fg);
    /* Close the dark Work→Stats panel: mirror Work's 24px top radius at the
       bottom so the panel reads as one intentional block before About (cream). */
    border-radius: 0 0 24px 24px;
    padding-bottom: clamp(4rem, 9vw, 8rem);
  }
  .stats__grid {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: clamp(1.5rem, 3vw, 3rem);
    border-top: 1px solid var(--dark-line);
    padding-top: clamp(2.5rem, 5vw, 4rem);
  }
  .stat__num {
    font-size: clamp(1.5rem, 2.6vw, 2.4rem);
    line-height: 1.05; color: var(--dark-fg);
    letter-spacing: -0.01em;
  }
  .stat__label { color: var(--dark-muted); font-size: 0.92rem; max-width: 26ch; margin-top: 0.9rem; }
  @media (max-width: 860px) { .stats__grid { grid-template-columns: repeat(2, 1fr); row-gap: 2.5rem; } }
  @media (max-width: 460px) { .stats__grid { grid-template-columns: 1fr; } }
</style>
