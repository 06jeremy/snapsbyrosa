---
// Contact — a multi-step enquiry wizard (see ../scripts/contact-wizard.js).
// Low-friction "conversational" flow: pick what you want → how to connect →
// details → a time → send. WhatsApp uses a wa.me deep link (no backend);
// Google Meet requests are delivered via Web3Forms (or mailto fallback).
//
// ⚠️ REAL VALUES NEEDED (placeholders below, all flagged):
//   • WHATSAPP_NUMBER — Jeremy's real WhatsApp in international format
//                       (digits only, no + / spaces / leading 0).
//   • AVAILABILITY    — the real days + time slots to offer (CET, The Hague).
//   • WEB3FORMS_KEY   — free access key from web3forms.com so Google-Meet
//                       requests land in Jeremy's inbox. Empty ⇒ mailto fallback.
//   NOTE: a static site cannot auto-generate a live Google Meet link, so the
//   chosen slot is a REQUEST — Jeremy confirms it with the actual invite.
const WHATSAPP_NUMBER = '31641592658';             // Jeremy's number, intl format (from (06)41592658)
const PUBLIC_EMAIL = 'info@snapsbyrosa.com';       // shown publicly in the aside
const DELIVERY_EMAIL = 'jeremy.rosa06@gmail.com';  // where Google-Meet requests are delivered
const WEB3FORMS_KEY = '';                          // PLACEHOLDER (optional) — grab a free key at web3forms.com
                                                   // using jeremy.rosa06@gmail.com; empty ⇒ mailto fallback.
const AVAILABILITY = {
  weekdays: [1, 2, 3, 4, 5, 6],                    // Mon–Sat (never Sundays; 0=Sun … 6=Sat)
  slots: ['17:00', '17:30', '18:00', '18:30'],     // 5–7pm window, CET (The Hague)
  // Per-weekday cut-offs: slots at/after this time are hidden for that day.
  //   Wed (3): nothing 18:30 onwards.  Sat (6): nothing 20:00 onwards
  //   (all current slots are < 20:00, so Sat is unaffected — kept for future).
  cutoffs: { 3: '18:30', 6: '20:00' },
  daysToShow: 6,
};

const wizConfig = {
  whatsapp: WHATSAPP_NUMBER,
  email: DELIVERY_EMAIL,
  web3formsKey: WEB3FORMS_KEY,
  availability: AVAILABILITY,
};

const projectTypes = [
  { id: 'personal',  label: 'Personal brand shoot',       hint: 'Editorial portraits & lifestyle' },
  { id: 'founder',   label: 'Founder & personal brand',   hint: 'Presence for people building a name' },
  { id: 'company',   label: 'The people behind the brand',hint: 'Company story · employer branding' },
  { id: 'milestone', label: 'Milestone or launch',        hint: 'A signing, a launch, a moment' },
  { id: 'social',    label: 'Reels & social content',     hint: 'Short-form, carousels, ongoing' },
  { id: 'other',     label: 'Something else',             hint: 'Tell me in your own words' },
];
---
<section class="contact" id="contact">
  <div class="container">
    <p class="eyebrow reveal">( Let’s create )</p>
    <h2 class="contact__title display reveal" aria-label="Let's make it personal">
      <span class="mask"><span data-word>Let’s make</span></span>
      <span class="mask"><span data-word>it <em>personal</em></span></span>
    </h2>

    <div class="contact__panel">
      <!-- Enquiry wizard -->
      <div class="wizard reveal" data-wizard>
        <script type="application/json" data-wiz-config set:html={JSON.stringify(wizConfig)}></script>

        <div class="wiz__progress" data-progress>
          <span class="wiz__progress-text" data-progress-text>Step 1 of 5</span>
          <div class="wiz__bar" role="presentation"><span class="wiz__bar-fill" data-bar-fill></span></div>
        </div>

        <!-- Step 1: type -->
        <div class="wiz__step" data-step="type">
          <h3 class="wiz__q" tabindex="-1" data-q>What can I help you create?</h3>
          <div class="wiz__opts" role="radiogroup" aria-label="Project type">
            {projectTypes.map((t) => (
              <label class="opt">
                <input type="radio" name="wiz-type" value={t.id} data-label={t.label} />
                <span class="opt__label">{t.label}</span>
                <span class="opt__hint">{t.hint}</span>
              </label>
            ))}
          </div>
          <div class="wiz__field wiz__field--other" data-other hidden>
            <label class="field__label" for="wiz-type-other">In your own words</label>
            <input id="wiz-type-other" type="text" placeholder="Tell me what you have in mind…" />
          </div>
          <p class="wiz__error" data-error role="alert" tabindex="-1" hidden></p>
        </div>

        <!-- Step 2: channel -->
        <div class="wiz__step" data-step="channel" hidden>
          <h3 class="wiz__q" tabindex="-1" data-q>How should we connect?</h3>
          <p class="wiz__sub">Pick whichever’s easiest. I’ll reach out there.</p>
          <div class="wiz__opts wiz__opts--2" role="radiogroup" aria-label="How to connect">
            <label class="opt opt--channel">
              <input type="radio" name="wiz-channel" value="whatsapp" data-label="WhatsApp" />
              <span class="opt__label">WhatsApp</span>
              <span class="opt__hint">A quick chat on your phone</span>
            </label>
            <label class="opt opt--channel">
              <input type="radio" name="wiz-channel" value="meet" data-label="Google Meet" />
              <span class="opt__label">Google Meet</span>
              <span class="opt__hint">A short video call</span>
            </label>
          </div>
          <p class="wiz__error" data-error role="alert" tabindex="-1" hidden></p>
        </div>

        <!-- Step 3: details -->
        <div class="wiz__step" data-step="details" hidden>
          <h3 class="wiz__q" tabindex="-1" data-q>A few quick details.</h3>
          <!-- WhatsApp: no number needed — sending the chat delivers it, and I
               see your number automatically as the sender. -->
          <p class="wiz__sub" data-when="whatsapp" hidden>No number needed. Send the chat and I’ll see it, and your number, straight away.</p>
          <div class="wiz__field" data-when="meet" hidden>
            <label class="field__label" for="wiz-email">Your email</label>
            <input id="wiz-email" name="wiz-email" type="email" autocomplete="email" placeholder="you@email.com" />
            <span class="field__sub">I’ll send your Google Meet invite here.</span>
          </div>
          <div class="wiz__field">
            <label class="field__label" for="wiz-message">Anything specific in mind? <span class="field__opt">(optional)</span></label>
            <textarea id="wiz-message" name="wiz-message" rows="3" placeholder="A launch film, monthly content, a team story…"></textarea>
          </div>
          <p class="wiz__error" data-error role="alert" tabindex="-1" hidden></p>
        </div>

        <!-- Step 4: time -->
        <div class="wiz__step" data-step="time" hidden>
          <h3 class="wiz__q" tabindex="-1" data-q>When suits you for a call?</h3>
          <p class="wiz__sub">Times shown in CET (The Hague). Pick a day, then a slot.</p>
          <div class="wiz__chips" data-days aria-label="Available days"></div>
          <div class="wiz__slots-wrap" data-slots-wrap hidden>
            <p class="wiz__slots-label">Available times</p>
            <div class="wiz__chips" data-slots aria-label="Available times"></div>
          </div>
          <button type="button" class="wiz__flexible" data-flexible aria-pressed="false">
            I’m flexible — suggest a time for me
          </button>
          <p class="wiz__error" data-error role="alert" tabindex="-1" hidden></p>
        </div>

        <!-- Step 5: review -->
        <div class="wiz__step" data-step="review" hidden>
          <h3 class="wiz__q" tabindex="-1" data-q>Look good?</h3>
          <dl class="wiz__summary">
            <div class="wiz__sum-row"><dt>Project</dt><dd data-sum="type">—</dd></div>
            <div class="wiz__sum-row"><dt>Connect via</dt><dd data-sum="channel">—</dd></div>
            <div class="wiz__sum-row" data-sum-contact-row><dt>Reach me at</dt><dd data-sum="contact">—</dd></div>
            <div class="wiz__sum-row"><dt>Preferred time</dt><dd data-sum="time">—</dd></div>
            <div class="wiz__sum-row" data-sum-message-row hidden><dt>Notes</dt><dd data-sum="message">—</dd></div>
          </dl>
          <p class="wiz__sub">Hit send and I’ll confirm within one business day.</p>
          <p class="wiz__error" data-error role="alert" tabindex="-1" hidden></p>
        </div>

        <!-- Done -->
        <div class="wiz__step wiz__done" data-step="done" hidden>
          <h3 class="wiz__q" tabindex="-1" data-q>Thank you. That’s sent.</h3>
          <p class="wiz__done-msg" data-done-when="whatsapp" hidden>
            I’ve opened WhatsApp with your details. If nothing happened,
            <a data-wa-fallback href="#" target="_blank" rel="noopener">tap here to open the chat</a>.
          </p>
          <p class="wiz__done-msg" data-done-when="meet" hidden>
            Thanks. I’ll confirm your Google Meet and send an invite to
            <strong data-done-email>your email</strong> within one business day.
          </p>
        </div>

        <!-- Nav -->
        <div class="wiz__nav" data-nav>
          <button type="button" class="wiz__back" data-back hidden>← Back</button>
          <button type="button" class="btn btn--red wiz__next" data-next>
            <span data-next-label>Continue</span> <span class="arrow">→</span>
          </button>
        </div>

        <noscript>
          <p class="wiz__noscript">
            Prefer to write directly? Email <a href="mailto:info@snapsbyrosa.com">info@snapsbyrosa.com</a>
            or message on <a href="https://wa.me/31641592658" target="_blank" rel="noopener">WhatsApp</a>.
          </p>
        </noscript>
      </div>
    </div>

    <!-- General contact info, full width below the form -->
    <div class="contact__info">
      <div class="contact__info-item reveal">
        <span class="contact__k">Email</span>
        <a href="mailto:info@snapsbyrosa.com" class="contact__v">info@snapsbyrosa.com</a>
      </div>
      <div class="contact__info-item reveal">
        <span class="contact__k">Based in</span>
        <span class="contact__v">The Hague · Available worldwide</span>
      </div>
      <div class="contact__info-item reveal">
        <span class="contact__k">Social</span>
        <!-- Only real, live profiles here — dead/placeholder links hurt trust.
             TODO(real-content): when Jeremy adds Vimeo/YouTube (film reels) or
             LinkedIn (founder/company work), add them below AND to `sameAs` in
             Layout.astro's JSON-LD. -->
        <span class="contact__v contact__social">
          <a href="https://instagram.com/snapsbyrosa" target="_blank" rel="noopener">Instagram</a>
        </span>
      </div>
      <div class="contact__info-item reveal">
        <span class="contact__k">Pricing</span>
        <span class="contact__v contact__v--sm">Shared on enquiry, tailored to the shoot.</span>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/contact-wizard.js';
</script>

<style>
  .contact { padding-block: clamp(4.5rem, 11vw, 10rem); }
  .contact__title { font-size: clamp(3rem, 11vw, 9rem); color: var(--red); line-height: 0.9; margin: 0.6rem 0 clamp(2.5rem, 6vw, 4.5rem); }
  .contact__title .mask { display: block; overflow: hidden; }
  .contact__title .mask span { display: block; }
  .contact__title em { font-style: italic; color: var(--ink); }

  /* Single block: the form sits in one panel, contact info runs full-width below */
  .contact__panel {
    max-width: 720px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(1.5rem, 4vw, 2.75rem);
    background: color-mix(in srgb, var(--paper) 60%, transparent);
  }

  /* ---- Wizard ---- */
  .wizard { min-height: 340px; display: flex; flex-direction: column; }
  /* Enforce the [hidden] attribute: several wizard elements set display
     (flex/grid), which would otherwise override the UA `[hidden]{display:none}`
     and leak hidden steps, the nav on the done panel, conditional fields, etc. */
  .wizard [hidden] { display: none !important; }
  .wiz__progress { margin-bottom: clamp(1.5rem, 3vw, 2.25rem); }
  .wiz__progress-text { font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 600; color: var(--muted); }
  .wiz__bar { margin-top: 0.6rem; height: 3px; background: var(--line); border-radius: var(--radius-pill); overflow: hidden; }
  .wiz__bar-fill { display: block; height: 100%; width: 20%; background: var(--red); border-radius: var(--radius-pill); transition: width 0.5s var(--ease); }

  .wiz__step { animation: wizIn 0.45s var(--ease) both; }
  @keyframes wizIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  :global(.no-motion) .wiz__step { animation: none; }

  .wiz__q { font-family: var(--font-display); font-size: clamp(1.5rem, 3.4vw, 2.4rem); line-height: 1.05; letter-spacing: -0.02em; outline: none; }
  .wiz__sub { color: var(--muted); margin-top: 0.6rem; font-size: 0.95rem; }

  .wiz__opts { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-top: 1.5rem; }
  .wiz__opts--2 { grid-template-columns: 1fr 1fr; }
  @media (max-width: 520px) { .wiz__opts, .wiz__opts--2 { grid-template-columns: 1fr; } }

  .opt {
    position: relative; display: flex; flex-direction: column; gap: 0.25rem;
    padding: 1rem 1.1rem; border: 1.5px solid var(--line-strong); border-radius: var(--radius);
    cursor: pointer; background: transparent;
    transition: border-color 0.25s var(--ease), background 0.25s var(--ease), transform 0.25s var(--ease);
  }
  .opt:hover { border-color: var(--red); background: var(--red); }
  .opt:hover .opt__label { color: var(--dark-fg); }
  .opt:hover .opt__hint { color: var(--dark-fg); opacity: 0.85; }
  .opt input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .opt__label { font-weight: 700; font-size: 1.02rem; }
  .opt__hint { font-size: 0.82rem; color: var(--muted); }
  .opt:has(input:checked) { border-color: var(--red); background: color-mix(in srgb, var(--red) 6%, transparent); }
  .opt:has(input:checked) .opt__label { color: var(--red); }
  .opt:has(input:focus-visible) { outline: 2px solid var(--red); outline-offset: 2px; }
  .opt--channel { padding: 1.25rem 1.2rem; }

  .wiz__field { display: flex; flex-direction: column; gap: 0.45rem; margin-top: 1.4rem; }
  .wiz__field--other { margin-top: 1rem; }
  .field__label { font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 600; color: var(--muted); }
  .field__opt { text-transform: none; letter-spacing: 0; font-weight: 500; opacity: 0.8; }
  .field__sub { font-size: 0.8rem; color: var(--muted); margin-top: 0.4rem; }
  .wiz__field input, .wiz__field textarea {
    font: inherit; color: var(--ink); background: transparent;
    border: 0; border-bottom: 1.5px solid var(--line-strong);
    padding: 0.7rem 0; resize: vertical;
    transition: border-color 0.3s var(--ease);
  }
  .wiz__field input::placeholder, .wiz__field textarea::placeholder { color: color-mix(in srgb, var(--muted) 70%, transparent); }
  .wiz__field input:focus, .wiz__field textarea:focus { outline: none; border-color: var(--red); }

  /* time chips — the .chip buttons are created in JS, so Astro's scoped
     data-attribute isn't on them. Mark these rules :global (scoped under
     .wizard so they can't leak) so they still apply to the generated chips. */
  .wiz__chips { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.4rem; }
  .wizard :global(.chip) {
    font: inherit; font-size: 0.95rem; font-weight: 600;
    padding: 0.6rem 1.05rem; border-radius: var(--radius-pill);
    border: 1.5px solid var(--line-strong); background: transparent; color: var(--ink);
    cursor: pointer; transition: border-color 0.2s var(--ease), background 0.2s var(--ease), color 0.2s var(--ease);
  }
  .wizard :global(.chip):hover { border-color: var(--ink-soft); }
  .wizard :global(.chip[aria-pressed="true"]) { border-color: var(--red); background: var(--red); color: #fff; }
  .wizard :global(.chip):focus-visible { outline: 2px solid var(--red); outline-offset: 2px; }
  .wiz__slots-wrap { margin-top: 1.5rem; }
  .wiz__slots-label { font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 600; color: var(--muted); }
  .wiz__flexible {
    margin-top: 1.5rem; font: inherit; font-size: 0.9rem; color: var(--muted);
    text-decoration: underline; text-underline-offset: 3px; cursor: pointer; background: none; border: 0; display: block;
  }
  .wiz__flexible:hover { color: var(--ink); }
  .wiz__flexible[aria-pressed="true"] { color: var(--red); font-weight: 600; }

  /* review summary */
  .wiz__summary { margin-top: 1.5rem; display: flex; flex-direction: column; gap: 0; }
  .wiz__sum-row { display: flex; justify-content: space-between; gap: 1.5rem; padding: 0.85rem 0; border-top: 1px solid var(--line); }
  .wiz__sum-row dt { font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 600; color: var(--muted); flex-shrink: 0; }
  .wiz__sum-row dd { text-align: right; font-weight: 500; }

  /* done */
  .wiz__done-msg { margin-top: 1rem; color: var(--muted); max-width: 46ch; line-height: 1.55; }
  .wiz__done-msg a { color: var(--red); text-decoration: underline; text-underline-offset: 3px; }

  .wiz__error { color: var(--red); font-size: 0.85rem; margin-top: 1rem; outline: none; }

  .wiz__nav { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 2rem; }
  .wiz__back { font: inherit; font-size: 0.9rem; font-weight: 600; color: var(--muted); background: none; border: 0; cursor: pointer; }
  .wiz__back:hover { color: var(--ink); }
  .wiz__next { margin-left: auto; }
  .wiz__next[disabled] { opacity: 0.6; cursor: progress; }
  .wiz__noscript { margin-top: 1.5rem; color: var(--muted); }
  .wiz__noscript a { color: var(--red); text-decoration: underline; }

  /* ---- General contact info (full-width row below the form) ---- */
  .contact__info {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--line);
  }
  .contact__info-item { display: flex; flex-direction: column; gap: 0.4rem; }
  .contact__k { font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .contact__v { font-family: var(--font-display); font-size: 1.1rem; }
  .contact__v--sm { font-family: var(--font-sans); font-size: 0.95rem; color: var(--ink-soft); line-height: 1.4; }
  a.contact__v:hover { color: var(--red); }
  .contact__social { display: flex; gap: 1.25rem; font-family: var(--font-sans); font-size: 0.95rem; }
  .contact__social a:hover { color: var(--red); }

  @media (max-width: 720px) {
    .contact__info { grid-template-columns: repeat(2, 1fr); row-gap: 2rem; }
  }
  @media (max-width: 420px) {
    .contact__info { grid-template-columns: 1fr; }
  }
</style>
