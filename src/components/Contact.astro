---
import { Image } from 'astro:assets';
import { getLocalImage } from '../lib/images.ts';
import { whatsapp, EMAIL, INSTAGRAM } from '../lib/contact.ts';
---
<section class="contact panel" id="contact" aria-labelledby="contact-title">
  <div class="panel__bg">
    <Image src={getLocalImage('14.jpg')} alt="" widths={[768, 1280, 1920]} sizes="100vw" format="webp" quality={68} loading="lazy" decoding="async" style="object-position: 50% 45%" />
  </div>
  <div class="container contact__body">
    <h2 id="contact-title" class="display contact__title">Book a session.</h2>
    <a href={whatsapp()} class="btn" target="_blank" rel="noopener">Book on WhatsApp</a>
    <ul class="contact__alt">
      <li>Email <a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
      <li>Instagram <a href={INSTAGRAM} target="_blank" rel="noopener">@snapsbyrosa</a></li>
    </ul>
  </div>
</section>

<style>
  .contact { min-height: 80svh; }
  .contact__body { display: flex; flex-direction: column; align-items: flex-start; gap: 1.5rem; }
  .contact__title { font-size: clamp(3.4rem, 12vw, 11rem); }
  .contact__alt { list-style: none; display: flex; flex-direction: column; gap: 0.25rem; }
  .contact__alt a { display: inline-block; padding-block: 0.7rem; border-bottom: 1px solid currentColor; }
  .contact__alt a:hover { color: var(--smoke); }
</style>
