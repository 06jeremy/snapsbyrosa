---
const year = new Date().getFullYear();
const { light = false } = Astro.props;
---
<footer class={`footer${light ? ' footer--light' : ''}`}>
  <div class="container footer__in">
    <p>© {year} SNAPSBYROSA, The Hague</p>
    <a href="/legal">Legal and privacy</a>
  </div>
</footer>

<style>
  .footer { background: var(--night); color: var(--smoke); padding-block: 1.5rem; font-size: 0.9rem; }
  .footer--light { background: var(--bg); color: var(--muted); border-top: 1px solid var(--line); }
  .footer__in { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; }
  .footer a { display: inline-block; padding-block: 0.8rem; }
  .footer a:hover { color: var(--red); }
</style>
