---
// Logo cloud — an infinite, edge-faded marquee of client logos on the brand
// cream band. Native Astro + CSS (no React/Tailwind), zero JS added beyond the
// shared marquee.
//
// Every logo is rendered as a UNIFORM MONOCHROME INK SILHOUETTE: `filter:
// brightness(0)` collapses any source art (white OR full-colour) down to a solid
// ink shape while preserving its alpha, so mixed-provenance logos (e.g. CINEX's
// coloured hexagon, MEO's white wordmark) read as one calm, on-brand set on the
// cream background. Reduced opacity keeps them quiet; hover lifts to full ink.
//
// REAL clients (Jeremy Rosa / SNAPSBYROSA). Real logo art is dropped in via `img`;
// clients without a usable transparent logo yet fall back to a text wordmark.
// TODO(logos): add the remaining art, then set `img` on that entry:
//   • Government of Curaçao — awaiting logo (transparent PNG/SVG; colour is fine,
//                             brightness(0) makes it monochrome)
//   • Favela Street         — awaiting logo (transparent PNG or SVG)
//   • Youmeet               — only JPEGs on disk (solid bg); need transparent version
//   • CSA                   — awaiting logo
// Assets live in /public/img/logos/. Any transparent PNG/SVG works — colour is
// normalised away, so no need to source special white versions.
const clients = [
  { name: 'CINEX', img: '/img/logos/cinex.png', w: 2943, h: 918 },
  { name: 'MEO', img: '/img/logos/meo.png', w: 734, h: 174 },
  { name: 'Government of Curaçao' },
  { name: 'Favela Street' },
  { name: 'Youmeet' },
  { name: 'CSA' },
];
---
<section class="logocloud" aria-label="Clients who trusted me to tell their story">
  <div class="container logocloud__grid">
    <p class="logocloud__label">Trusted to tell their story</p>
    <div class="logocloud__viewport">
      <div class="logocloud__track" data-marquee-track data-marquee-speed="40" data-marquee-slow="18" aria-hidden="true">
        {[...clients, ...clients].map((c) => (
          c.img
            ? <span class="logocloud__item"><img class="logocloud__logo" src={c.img} alt={c.name} width={c.w} height={c.h} loading="lazy" decoding="async" /></span>
            : <span class="logocloud__item logocloud__item--text">{c.name}</span>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .logocloud {
    background: var(--paper);
    color: var(--ink);
    padding-block: clamp(2.25rem, 5vw, 3.5rem);
    border-block: 1px solid var(--line);
  }
  .logocloud__grid {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2rem);
  }
  .logocloud__label {
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--muted);
  }

  /* Fade the edges so logos dissolve rather than clip hard */
  .logocloud__viewport {
    position: relative;
    width: 100%;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 80px, #000 calc(100% - 80px), transparent);
    mask-image: linear-gradient(to right, transparent, #000 80px, #000 calc(100% - 80px), transparent);
  }
  .logocloud__track {
    display: inline-flex;
    align-items: center;
    will-change: transform;
  }

  .logocloud__item {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    padding-inline: clamp(1.5rem, 3.5vw, 3rem);
    white-space: nowrap;
  }
  /* Real logo images: normalised to one height AND one colour. brightness(0)
     collapses any source art (white or full-colour) to a solid ink silhouette,
     preserving alpha — so every client reads as the same calm ink-on-cream mark,
     no stray brand colours breaking the palette. */
  .logocloud__logo {
    height: clamp(1.5rem, 2.6vw, 2.1rem);
    width: auto;
    display: block;
    filter: brightness(0);
    opacity: 0.5;
    transition: opacity 0.3s var(--ease);
  }
  .logocloud__item:hover .logocloud__logo { opacity: 0.85; }
  /* Text fallback wordmarks (clients awaiting real logo art) */
  .logocloud__item--text {
    font-family: var(--font-sans);
    font-weight: 700;
    letter-spacing: 0.04em;
    font-size: clamp(0.95rem, 1.6vw, 1.2rem);
    color: var(--muted);
    opacity: 0.75;
    transition: opacity 0.3s var(--ease), color 0.3s var(--ease);
  }
  .logocloud__item--text:hover { opacity: 1; color: var(--red); }
</style>
