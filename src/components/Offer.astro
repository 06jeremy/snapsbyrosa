---
import { Image } from 'astro:assets';
import { getLocalImage } from '../lib/images.ts';
import { OFFERS, whatsapp } from '../lib/contact.ts';

const b = OFFERS.birthday;
const c = OFFERS.content;
const offers = [
  {
    title: 'Birthday portraits',
    lines: [
      `${b.hours} hour of shooting`,
      `${b.photos} edited photos and ${b.clips} short clip`,
    ],
    price: b.price,
    note: 'Birthday dinner or party? Message me for a quote.',
    img: 'portfolio-12.jpg',
    pos: '50% 28%',
    msg: 'Hi Jeremy, I’d like to book a birthday portrait session.',
  },
  {
    title: 'Content',
    lines: [
      'For your page or your business, one-off or monthly',
      `${c.photos} edited photos and ${c.clips} short clips`,
    ],
    price: c.price,
    img: 'portfolio-31.jpg',
    pos: '50% 40%',
    msg: 'Hi Jeremy, I’d like to book a content session.',
  },
];
---
<section class="offer" id="offer" aria-label="What I offer">
  {offers.map((o) => (
    <article class="panel offer__panel">
      <div class="panel__bg">
        <Image
          src={getLocalImage(o.img)}
          alt=""
          widths={[640, 960, 1280]}
          sizes="(max-width: 820px) 100vw, 50vw"
          format="webp"
          quality={72}
          loading="lazy"
          decoding="async"
          style={`object-position: ${o.pos}`}
        />
      </div>
      <div class="container offer__body">
        <h2 class="display offer__title">{o.title}</h2>
        <ul class="offer__lines">
          {o.lines.map((l) => <li>{l}</li>)}
        </ul>
        <p class="offer__price">From €{o.price}</p>
        <a href={whatsapp(o.msg)} class="btn" target="_blank" rel="noopener">Book on WhatsApp</a>
        {o.note && <p class="offer__note">{o.note}</p>}
      </div>
    </article>
  ))}
</section>

<style>
  .offer { display: grid; grid-template-columns: 1fr 1fr; }
  .offer__panel { padding-inline: 0; }
  .offer__body { display: flex; flex-direction: column; align-items: flex-start; gap: 0.75rem; }
  .offer__title { font-size: clamp(3rem, 8vw, 7.5rem); }
  .offer__lines { list-style: none; font-size: clamp(1.05rem, 1.5vw, 1.2rem); line-height: 1.45; }
  .offer__price { font-size: 1.6rem; font-weight: 800; font-stretch: 75%; margin: 0.25rem 0 0.5rem; }
  .offer__note { font-size: 0.95rem; color: var(--bone); opacity: 0.85; }
  @media (max-width: 820px) {
    .offer { grid-template-columns: 1fr; }
    .offer__panel { min-height: 80svh; }
  }
</style>
