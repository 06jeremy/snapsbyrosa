---
/*
  Privacy-first, consent-gated Google Analytics 4.

  HOW TO TURN IT ON (30 seconds):
    1. Create a free GA4 property at https://analytics.google.com
       (Admin → Create property → add a "Web" data stream for snapsbyrosa.com).
    2. Copy the Measurement ID — it looks like  G-XXXXXXXXXX.
    3. Paste it into GA_ID below and rebuild. Done.

  Until you add an ID, this component renders NOTHING — no banner, no scripts,
  no cookies. Nothing to consent to yet, so nothing shows.

  When an ID IS set:
    • A small cookie banner appears on first visit (bottom of the screen).
    • NO Google script and NO cookies load until the visitor taps "Accept".
      This is the privacy-preserving default (GDPR/AVG friendly for the EU).
    • "Decline" is remembered and GA never loads for that visitor.
    • The choice is stored in localStorage so the banner shows only once.

  If you'd rather have analytics with NO cookie banner at all, use a
  cookieless tool like Plausible or Umami instead — see ROADMAP.md.
*/
const GA_ID = ''; // ← paste your G-XXXXXXXXXX here to switch analytics on
---

{GA_ID && (
  <div class="cc" data-cc hidden aria-live="polite">
    <p class="cc__text">
      This site uses cookies only to measure visits (Google Analytics), so I can
      see what's working. No ads, no tracking across other sites.
    </p>
    <div class="cc__actions">
      <button type="button" class="cc__btn cc__btn--ghost" data-cc-decline>Decline</button>
      <button type="button" class="cc__btn cc__btn--solid" data-cc-accept>Accept</button>
    </div>
  </div>

  <script is:inline define:vars={{ GA_ID }}>
    (function () {
      var KEY = 'sbr-consent';
      var banner = document.querySelector('[data-cc]');

      function loadGA() {
        if (window.__sbrGaLoaded) return;
        window.__sbrGaLoaded = true;
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        function gtag() { window.dataLayer.push(arguments); }
        window.gtag = gtag;
        gtag('js', new Date());
        // IP anonymisation on; no ad personalisation.
        gtag('config', GA_ID, { anonymize_ip: true, allow_google_signals: false });
      }

      var choice = null;
      try { choice = localStorage.getItem(KEY); } catch (e) {}

      if (choice === 'granted') {
        loadGA();
      } else if (choice !== 'denied' && banner) {
        banner.hidden = false;
      }

      if (banner) {
        banner.querySelector('[data-cc-accept]').addEventListener('click', function () {
          try { localStorage.setItem(KEY, 'granted'); } catch (e) {}
          banner.hidden = true;
          loadGA();
        });
        banner.querySelector('[data-cc-decline]').addEventListener('click', function () {
          try { localStorage.setItem(KEY, 'denied'); } catch (e) {}
          banner.hidden = true;
        });
      }
    })();
  </script>
)}

<style>
  .cc {
    position: fixed; z-index: 1000;
    left: 1rem; right: 1rem; bottom: 1rem;
    max-width: 480px; margin-inline: auto;
    background: var(--ink); color: var(--dark-fg);
    border: 1px solid var(--dark-line); border-radius: var(--radius);
    padding: 1.1rem 1.25rem;
    box-shadow: 0 20px 50px rgba(0,0,0,0.35);
    display: flex; flex-direction: column; gap: 0.9rem;
    animation: ccIn 0.5s var(--ease) both;
  }
  @keyframes ccIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  :global(.no-motion) .cc { animation: none; }
  .cc__text { font-size: 0.85rem; line-height: 1.5; color: var(--dark-muted); }
  .cc__actions { display: flex; gap: 0.6rem; justify-content: flex-end; }
  .cc__btn {
    font: inherit; font-size: 0.85rem; font-weight: 600;
    padding: 0.5rem 1.1rem; border-radius: var(--radius-pill); cursor: pointer;
    border: 1.5px solid transparent; transition: background 0.25s var(--ease), border-color 0.25s var(--ease);
  }
  .cc__btn--ghost { background: transparent; border-color: var(--dark-line); color: var(--dark-fg); }
  .cc__btn--ghost:hover { border-color: var(--dark-muted); }
  .cc__btn--solid { background: var(--red); color: #fff; }
  .cc__btn--solid:hover { background: var(--red-deep); }
</style>
