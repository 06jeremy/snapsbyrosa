---
// Testimonials — SCAFFOLD with placeholders. Nothing here is a real quote; the
// visible text tells you exactly what to drop in. Two parts:
//   1) VIDEO wall (vertical 9:16). Add a real file path to `src` and the card
//      turns into a working <video> player automatically. Leave `src: ''` and it
//      shows a "coming soon" poster tile so the layout still looks right.
//      Put video files in /public/video/ and reference them as '/video/name.mp4'.
//   2) TEXT quotes with a headshot + name + function title.
//
// PLACEHOLDER IMAGES reuse portfolio frames from /public/img. Swap posters +
// headshots for the real people (with their permission) before launch. Do NOT
// invent quotes — pull the wording straight from what each client sends back.
import { Image } from 'astro:assets';
import { getLocalImage } from '../lib/images.ts';

const videos = [
  { src: '/video/testimonial-akeela-csa.mp4', poster: '/img/testimonial-akeela-poster.jpg', name: 'Akeela Martin', role: 'CSA' },
  { src: '', poster: '/img/portfolio-26.jpg', name: 'Client name', role: 'Personal brand' },
  { src: '', poster: '/img/portfolio-11.jpg', name: 'Client name', role: 'Braiding artist' },
];

const quotes = [
  {
    headshot: '/img/portfolio-25.jpg',
    name: 'Client name',
    role: 'Wedding',
    quote: 'Their words go here — a sentence or two, pulled straight from the video they send or a short message. Keep it in their own voice.',
  },
  {
    headshot: '/img/portfolio-09.jpg',
    name: 'Client name',
    role: 'Personal brand · founder',
    quote: 'Their words go here — the bit about what it was actually like to work together, or the result they got. Specific beats polished.',
  },
  {
    headshot: '/img/portfolio-12.jpg',
    name: 'Client name',
    role: 'Fashion',
    quote: 'Their words go here — what they’d say to someone on the fence about booking. One honest line is enough.',
  },
];
---
<section class="tst section" id="testimonials" aria-labelledby="tst-title">
  <div class="container">
    <header class="tst__head">
      <span class="eyebrow reveal">Testimonials</span>
      <h2 id="tst-title" class="tst__title condensed reveal">In their<br />own words</h2>
      <p class="tst__intro reveal">Straight from the people I’ve worked with — on camera and in writing.</p>
    </header>

    <!-- 1) VIDEO WALL ------------------------------------------------------ -->
    <div class="tst__videos" role="list">
      {videos.map((v) => (
        <figure class="vt reveal" role="listitem">
          {v.src ? (
            <video class="vt__media" controls playsinline preload="none" poster={v.poster}>
              <source src={v.src} type="video/mp4" />
              Your browser can’t play this video.
            </video>
          ) : (
            <div class="vt__media vt__ph">
              <Image src={getLocalImage(v.poster)} alt="" widths={[280, 560]} sizes="(max-width: 820px) 50vw, 300px" format="webp" quality={72} loading="lazy" decoding="async" />
              <span class="vt__play" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              </span>
              <span class="vt__soon">Video coming soon</span>
            </div>
          )}
          <figcaption class="vt__cap">
            <strong>{v.name}</strong>
            <span>{v.role}</span>
          </figcaption>
        </figure>
      ))}
    </div>

    <!-- 2) TEXT QUOTES ----------------------------------------------------- -->
    <div class="tst__quotes">
      {quotes.map((q) => (
        <figure class="qt reveal">
          <blockquote class="qt__quote">{q.quote}</blockquote>
          <figcaption class="qt__cap">
            <Image class="qt__avatar" src={getLocalImage(q.headshot)} alt={`${q.name} headshot`} widths={[56, 112]} sizes="56px" format="webp" quality={72} loading="lazy" decoding="async" />
            <span class="qt__who">
              <strong>{q.name}</strong>
              <em>{q.role}</em>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .tst { background: var(--bg); color: var(--ink); }
  .tst__head { max-width: 60ch; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .tst__title { font-size: clamp(2.2rem, 7vw, 5rem); margin-block: 0.6rem 0.9rem; }
  .tst__intro { color: var(--ink-soft); font-size: clamp(1rem, 1.6vw, 1.2rem); max-width: 44ch; }

  /* ---- Video wall (vertical 9:16) ---- */
  .tst__videos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2.4vw, 1.75rem);
    max-width: 900px;
  }
  .vt { margin: 0; }
  .vt__media {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--ink);
    display: block;
  }
  video.vt__media { object-fit: cover; }
  .vt__ph img { width: 100%; height: 100%; object-fit: cover; filter: saturate(0.92) brightness(0.82); }
  .vt__ph::after {
    content: ""; position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(10,8,6,0.6) 0%, rgba(10,8,6,0) 55%);
  }
  .vt__play {
    position: absolute; inset: 0; margin: auto;
    width: 58px; height: 58px; border-radius: 50%;
    display: grid; place-items: center;
    background: color-mix(in srgb, var(--red) 92%, transparent);
    color: #fff; box-shadow: 0 6px 24px rgba(0,0,0,0.35);
  }
  .vt__play svg { transform: translateX(1px); }
  .vt__soon {
    position: absolute; left: 0; right: 0; bottom: 0.75rem; z-index: 1;
    text-align: center; color: #fff;
    font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 600;
  }
  .vt__cap { display: flex; flex-direction: column; gap: 0.1rem; margin-top: 0.7rem; }
  .vt__cap strong { font-size: 0.95rem; }
  .vt__cap span { color: var(--muted); font-size: 0.82rem; }

  /* ---- Text quotes ---- */
  .tst__quotes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.25rem, 3vw, 2rem);
    margin-top: clamp(3rem, 6vw, 5rem);
    border-top: 1px solid var(--line);
    padding-top: clamp(2.5rem, 5vw, 4rem);
  }
  .qt { margin: 0; display: flex; flex-direction: column; gap: 1.5rem; }
  .qt__quote {
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: 1.45; color: var(--ink);
  }
  .qt__quote::before { content: "“"; color: var(--red); font-weight: 700; }
  .qt__quote::after { content: "”"; color: var(--red); font-weight: 700; }
  .qt__cap { display: flex; align-items: center; gap: 0.85rem; margin-top: auto; }
  .qt__avatar { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; flex: none; }
  .qt__who { display: flex; flex-direction: column; }
  .qt__who strong { font-size: 0.95rem; }
  .qt__who em { font-style: normal; color: var(--muted); font-size: 0.85rem; }

  @media (max-width: 820px) {
    .tst__videos { grid-template-columns: repeat(2, 1fr); max-width: 560px; }
    .tst__quotes { grid-template-columns: 1fr; max-width: 46ch; }
  }
  @media (max-width: 480px) {
    .tst__videos { gap: 0.75rem; }
  }
</style>
