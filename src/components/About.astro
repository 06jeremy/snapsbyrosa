---
// Founder portrait (Jeremy Rosa) — his own high-res studio portrait (May 2025).
// Served through astro:assets: build-time WebP + responsive widths, so the ~460 KB
// source ships as a ~40–70 KB file at the size actually displayed.
import { Image } from 'astro:assets';
import { getLocalImage } from '../lib/images.ts';
const portrait = getLocalImage('/img/jeremy-rosa.jpg');
---
<section class="about section" id="about">
  <div class="container about__grid">
    <div class="about__media reveal">
      <div class="about__frame clip-reveal">
        <Image src={portrait} alt="Jeremy Rosa, founder of SNAPSBYROSA, in The Hague" widths={[480, 768, 1024, 1201]} sizes="(max-width: 820px) 100vw, 40vw" format="webp" quality={74} loading="lazy" decoding="async" />
      </div>
      <span class="about__badge">Jeremy Rosa · Founder</span>
    </div>

    <div class="about__body">
      <p class="eyebrow reveal">( About )</p>
      <h2 class="about__quote h-lg reveal">
        “I make photo and video that actually looks like <em>you</em> —
        not stiff, not staged.”
      </h2>
      <p class="lead reveal">
        I'm Jeremy Rosa — originally from Curaçao, now running SNAPSBYROSA, my
        one-person studio in The Hague. I work with athletes, founders and
        people marking a milestone, and with
        companies who want to show the people behind the brand. You get photo,
        film and social content, shot and edited by one person from start to finish.
      </p>
      <ul class="about__points">
        <li class="reveal"><span>01</span> One point of view across photo, video and social — not a template.</li>
        <li class="reveal"><span>02</span> Direction on the day, so you never feel awkward on camera.</li>
        <li class="reveal"><span>03</span> Edits that work on your site and across social.</li>
      </ul>
      <a href="#contact" class="btn btn--red reveal">Enquire <span class="arrow">→</span></a>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .about__media { position: relative; }
  .about__frame { border-radius: 6px; overflow: hidden; aspect-ratio: 4/5; }
  .about__frame img { width: 100%; height: 100%; object-fit: cover; }
  .about__badge {
    position: absolute; left: 1rem; bottom: 1rem;
    background: var(--paper); color: var(--ink);
    font-size: 0.75rem; font-weight: 600; letter-spacing: 0.02em;
    padding: 0.5rem 0.9rem; border-radius: var(--radius-pill);
    box-shadow: 0 10px 30px rgba(23,19,15,0.15);
  }
  .about__quote { max-width: 18ch; margin-top: 1rem; line-height: 1.1; }
  .about__quote em { font-style: italic; color: var(--red); }
  .about .lead { margin-top: 1.6rem; }
  .about__points { list-style: none; margin: 2rem 0; display: flex; flex-direction: column; gap: 1rem; }
  .about__points li {
    display: flex; gap: 1rem; align-items: baseline;
    border-top: 1px solid var(--line); padding-top: 1rem; font-size: 1rem;
  }
  .about__points span { color: var(--red); font-weight: 600; font-size: 0.85rem; }
  @media (max-width: 820px) { .about__grid { grid-template-columns: 1fr; } .about__quote { max-width: none; } }
</style>
