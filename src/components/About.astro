---
import { Image } from 'astro:assets';
import { getLocalImage } from '../lib/images.ts';
---
<section class="about panel" id="about" aria-labelledby="about-title">
  <div class="panel__bg">
    <Image src={getLocalImage('jeremy-rosa.jpg')} alt="Jeremy Rosa, photographer and videographer in The Hague" widths={[768, 1280, 1920]} sizes="100vw" format="webp" quality={72} loading="lazy" decoding="async" style="object-position: 50% 22%" />
  </div>
  <div class="container about__body">
    <h2 id="about-title" class="display about__title">I’m Jeremy.</h2>
    <p class="about__text">From Curaçao, based in The Hague. I shoot and edit everything myself and direct you during the shoot.</p>
  </div>
</section>

<style>
  .about { min-height: 80svh; }
  .about__body { display: flex; flex-direction: column; gap: 1rem; }
  .about__title { font-size: clamp(3.4rem, 12vw, 11rem); }
  .about__text { max-width: 34ch; font-size: clamp(1.1rem, 1.8vw, 1.4rem); line-height: 1.4; }
</style>
