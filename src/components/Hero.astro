---
import { Image } from 'astro:assets';
import { getLocalImage } from '../lib/images.ts';
import { TERMS, whatsapp } from '../lib/contact.ts';

// Four stations, read left to right. Only steps with a real fact get a second line.
const steps = [
  { t: 'Message me' },
  { t: 'Book', d: `${TERMS.depositPercent}% deposit` },
  { t: 'Shoot' },
  { t: 'Receive', d: `Within ${TERMS.deliveryDays} days` },
];
---
<section class="hero panel" id="top">
  <div class="panel__bg">
    <Image
      src={getLocalImage('hero-banner-poster.jpg')}
      alt=""
      widths={[768, 1280, 1920]}
      sizes="100vw"
      format="webp"
      quality={70}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <video
      class="hero__video"
      muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"
      data-wide="/video/hero-1920.mp4"
      data-narrow="/video/hero-1080.mp4"
    ></video>
  </div>

  <div class="container hero__body">
    <h1 class="hero__title display">Birthday portraits and content in The Hague.</h1>
    <p class="hero__sub">Photos and short clips, shot and edited by me.</p>
    <a href={whatsapp()} class="btn" target="_blank" rel="noopener">Book on WhatsApp</a>
  </div>

  <div class="container">
    <ol class="steps" aria-label="How booking works">
      {steps.map((s, i) => (
        <li>
          <span class="steps__n">{i + 1}</span>
          <strong>{s.t}</strong>
          {s.d && <span class="steps__d">{s.d}</span>}
        </li>
      ))}
    </ol>
  </div>
</section>

<script is:inline>
  (function () {
    var v = document.querySelector('.hero__video');
    if (!v) return;
    var c = navigator.connection || {};
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || c.saveData) return;
    v.addEventListener('playing', function () { v.classList.add('is-on'); });
    v.src = innerWidth > 900 ? v.dataset.wide : v.dataset.narrow;
    v.play().catch(function () {});
  })();
</script>

<style>
  .hero__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.9s var(--ease); }
  .hero__video.is-on { opacity: 1; }
  .hero__body { display: flex; flex-direction: column; align-items: flex-start; gap: 1.25rem; margin-bottom: clamp(2rem, 6vh, 4rem); }
  .hero__title { font-size: clamp(3.2rem, min(11.5vw, 15vh), 10.5rem); max-width: 14ch; }
  .hero__sub { font-size: clamp(1.05rem, 1.6vw, 1.3rem); }

  /* The process at a glance: one red line, four stations, one row at every width. */
  .steps {
    list-style: none;
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem;
    border-top: 2px solid var(--red);
  }
  .steps li { position: relative; display: flex; flex-direction: column; gap: 0.1rem; padding-top: 0.9rem; }
  .steps li::before {
    content: ""; position: absolute; top: -7px; left: 0;
    width: 12px; height: 12px; border-radius: 50%; background: var(--red);
  }
  .steps__n { font-size: 0.8rem; color: var(--smoke); font-variant-numeric: tabular-nums; }
  .steps strong { font-size: clamp(1.05rem, 2vw, 1.5rem); font-weight: 800; font-stretch: 75%; line-height: 1.15; }
  .steps__d { font-size: 0.875rem; line-height: 1.3; }
</style>
