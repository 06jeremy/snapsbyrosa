---
import { whatsapp } from '../lib/contact.ts';
// `light` is for pages on the light theme (legal): dark type, no photo behind.
const { light = false } = Astro.props;
---
<header class={`nav${light ? ' nav--light' : ''}`}>
  <div class="container nav__in">
    <a href="/" class="nav__brand condensed" aria-label="SNAPSBYROSA home">SNAPSBYROSA</a>
    <a href={whatsapp()} class="nav__cta" target="_blank" rel="noopener">Book on WhatsApp</a>
  </div>
</header>

<style>
  .nav { position: absolute; inset: 0 0 auto 0; z-index: 20; padding-block: 1.25rem; color: var(--bone); }
  .nav--light { color: var(--ink); }
  .nav__in { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .nav__brand { font-size: 1.5rem; display: inline-flex; align-items: center; min-height: 44px; }
  .nav__cta {
    font-size: 0.95rem; font-weight: 600;
    display: inline-flex; align-items: center; min-height: 44px;
    border-bottom: 2px solid var(--red);
    transition: color 0.3s var(--ease);
  }
  .nav__cta:hover { color: var(--red); }
</style>
