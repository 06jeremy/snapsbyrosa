---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Hero from '../../components/Hero.astro';
import Statement from '../../components/Statement.astro';
import Services from '../../components/Services.astro';
import Work from '../../components/Work.astro';
import Stats from '../../components/Stats.astro';
import LogoCloud from '../../components/LogoCloud.astro';
import About from '../../components/About.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
// Hidden until real client quotes exist — Testimonials.astro is still full of
// placeholders ("Client name", "Their words go here..."). Fill the `videos` +
// `quotes` arrays with real, permitted content, then restore the import below
// and the <Testimonials /> tag in the page.
// import Testimonials from '../../components/Testimonials.astro';
import VideoLightbox from '../../components/VideoLightbox.astro';
---

<Layout path="/home/">
  <a href="#main" class="skip-link">Skip to content</a>
  <Nav />
  <main id="main">
    <Hero />
    <LogoCloud />
    <Services />
    <Statement />
    <Work />
    <Stats />
    <About />
    <Contact />
  </main>
  <Footer />
  <VideoLightbox />
</Layout>

<script>
  import '../../scripts/main.js';
</script>
