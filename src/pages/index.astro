---
// Standalone "coming soon" holding page — this is the PUBLIC landing page.
// The full site lives at /home/ behind a lightweight password gate.
// NOTE: this gate keeps casual visitors out; it is not hard security (see the
// login script comment). For true protection put the domain behind Cloudflare
// Access (free) or a host with server-side auth.
import '../styles/global.css';
const title = 'SNAPSBYROSA — coming soon';
const description = 'SNAPSBYROSA — website under construction. Personal-brand photo, film and social content by Jeremy Rosa, The Hague.';
const pixieset = 'https://snapsbyrosa.mypixieset.com';
const instagram = 'https://instagram.com/snapsbyrosa';
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#e6e6e6" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62.5..125,400..800;1,62.5..125,400..800&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="cs">
    <!-- Top-right login -->
    <button type="button" class="cs__login" data-open-login aria-haspopup="dialog">Log in</button>

    <main class="cs__main">
      <h1 class="cs__mark">SNAPSBYROSA</h1>
      <p class="cs__sub">
        Website under construction — for now head to
        <a href={pixieset} class="cs__link">snapsbyrosa.mypixieset.com</a>
      </p>
      <a href={instagram} class="cs__ig" target="_blank" rel="noopener" aria-label="SNAPSBYROSA on Instagram">
        <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false">
          <path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
            d="M7 2.5h10A4.5 4.5 0 0 1 21.5 7v10a4.5 4.5 0 0 1-4.5 4.5H7A4.5 4.5 0 0 1 2.5 17V7A4.5 4.5 0 0 1 7 2.5Z" />
          <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.6" />
          <circle cx="17.4" cy="6.6" r="1.15" fill="currentColor" />
        </svg>
      </a>
    </main>

    <!-- Login dialog -->
    <div class="cs__overlay" data-login-overlay hidden>
      <div class="cs__dialog" role="dialog" aria-modal="true" aria-labelledby="cs-login-title">
        <button type="button" class="cs__close" data-close-login aria-label="Close">&times;</button>
        <h2 id="cs-login-title" class="cs__dialog-title">Enter password</h2>
        <form data-login-form>
          <label class="cs__field-label" for="cs-pw">Password</label>
          <input type="password" id="cs-pw" class="cs__input" autocomplete="off" autofocus />
          <p class="cs__error" data-login-error hidden>Incorrect password — try again.</p>
          <button type="submit" class="cs__submit">Enter site</button>
        </form>
      </div>
    </div>

    <script is:inline>
      // Lightweight client-side gate. NOT hard security: the check runs in the
      // browser, so it only keeps casual visitors out. On success we set a
      // session flag and send the owner to the real site at /home/.
      (function () {
        var overlay = document.querySelector('[data-login-overlay]');
        var form = document.querySelector('[data-login-form]');
        var pw = document.getElementById('cs-pw');
        var err = document.querySelector('[data-login-error]');
        var openBtn = document.querySelector('[data-open-login]');
        var closeBtn = document.querySelector('[data-close-login]');
        var PASSWORD = 'snapsbyrosa2006';

        function open() { overlay.hidden = false; err.hidden = true; pw.value = ''; setTimeout(function () { pw.focus(); }, 30); }
        function close() { overlay.hidden = true; openBtn.focus(); }

        openBtn.addEventListener('click', open);
        closeBtn.addEventListener('click', close);
        overlay.addEventListener('click', function (e) { if (e.target === overlay) close(); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !overlay.hidden) close(); });

        form.addEventListener('submit', function (e) {
          e.preventDefault();
          if (pw.value === PASSWORD) {
            try { sessionStorage.setItem('sbr-auth', '1'); } catch (e) {}
            window.location.href = '/home/';
          } else {
            err.hidden = false;
            pw.value = '';
            pw.focus();
          }
        });
      })();
    </script>

    <style>
      .cs {
        min-height: 100dvh; margin: 0;
        display: flex; align-items: center; justify-content: center;
        background: var(--bg); color: var(--ink);
        padding: 2rem;
      }
      .cs__login {
        position: fixed; top: 1.25rem; right: 1.25rem; z-index: 10;
        font: inherit; font-size: 0.85rem; font-weight: 600;
        padding: 0.5rem 1.15rem; border-radius: var(--radius-pill);
        border: 1.5px solid var(--line-strong); background: transparent; color: var(--ink);
        cursor: pointer; transition: border-color 0.25s var(--ease), background 0.25s var(--ease), color 0.25s var(--ease);
      }
      .cs__login:hover { border-color: var(--red); background: var(--red); color: var(--dark-fg); }
      .cs__login:focus-visible { outline: 2px solid var(--red); outline-offset: 2px; }

      .cs__main { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1.4rem; }
      .cs__mark {
        font-family: var(--font-display, 'Archivo'), sans-serif;
        font-weight: 800; color: var(--red);
        font-size: clamp(2.4rem, 11vw, 7rem); line-height: 0.95;
        letter-spacing: -0.02em; margin: 0;
        font-stretch: 75%;
      }
      .cs__sub { color: var(--muted); font-size: clamp(0.95rem, 2.4vw, 1.1rem); line-height: 1.6; max-width: 34ch; margin: 0; }
      .cs__link { color: var(--red); text-decoration: underline; text-underline-offset: 3px; font-weight: 600; }
      .cs__link:hover { color: var(--red-deep); }
      .cs__ig { display: inline-flex; color: var(--ink); transition: color 0.25s var(--ease), transform 0.25s var(--ease); margin-top: 0.25rem; }
      .cs__ig:hover { color: var(--red); transform: translateY(-2px); }
      .cs__ig:focus-visible { outline: 2px solid var(--red); outline-offset: 4px; border-radius: 4px; }

      .cs__overlay {
        position: fixed; inset: 0; z-index: 100;
        background: rgba(23,19,15,0.55); backdrop-filter: blur(3px);
        display: flex; align-items: center; justify-content: center; padding: 1.5rem;
      }
      /* Without this the `display:flex` above beats the browser's built-in
         [hidden]{display:none}, so the dialog would show on load. Keep it. */
      .cs__overlay[hidden] { display: none; }
      .cs__dialog {
        position: relative; background: var(--paper); color: var(--ink);
        border: 1px solid var(--line); border-radius: var(--radius);
        padding: 2rem 1.9rem; width: 100%; max-width: 360px;
        box-shadow: 0 24px 60px rgba(0,0,0,0.3);
      }
      .cs__close {
        position: absolute; top: 0.6rem; right: 0.8rem;
        background: none; border: none; font-size: 1.6rem; line-height: 1; cursor: pointer; color: var(--muted);
      }
      .cs__close:hover { color: var(--red); }
      .cs__dialog-title { font-size: 1.25rem; margin: 0 0 1.1rem; }
      .cs__field-label { display: block; font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 600; color: var(--muted); margin-bottom: 0.4rem; }
      .cs__input {
        width: 100%; font: inherit; padding: 0.7rem 0.85rem;
        border: 1.5px solid var(--line-strong); border-radius: var(--radius); background: #fff; color: var(--ink);
      }
      .cs__input:focus { outline: none; border-color: var(--red); }
      .cs__error { color: var(--red-deep); font-size: 0.85rem; margin: 0.6rem 0 0; }
      .cs__submit {
        margin-top: 1.1rem; width: 100%; font: inherit; font-weight: 600;
        padding: 0.7rem 1rem; border-radius: var(--radius-pill); border: none;
        background: var(--red); color: #fff; cursor: pointer; transition: background 0.25s var(--ease);
      }
      .cs__submit:hover { background: var(--red-deep); }
      @media (prefers-reduced-motion: reduce) {
        .cs__login, .cs__ig, .cs__submit { transition: none; }
      }
    </style>
  </body>
</html>
