---
// One landing page: hero with the booking process, what I offer, client video, who I am, book.
// The earlier full design lives on branch archive/v1-full-site (tag v1-full-site).
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Offer from '../components/Offer.astro';
import Proof from '../components/Proof.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import StickyBook from '../components/StickyBook.astro';
---

<Layout path="/">
  <a href="#main" class="skip-link">Skip to content</a>
  <Nav />
  <main id="main">
    <Hero />
    <Offer />
    <Proof />
    <About />
    <Contact />
  </main>
  <Footer />
  <StickyBook />
</Layout>
