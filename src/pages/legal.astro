---
// Legal & privacy — single page covering imprint (colofon), privacy policy
// (AVG/GDPR), cookies, terms of use, booking terms, and an FAQ. Content is a
// solid, standard baseline for a Dutch sole trader (eenmanszaak / ZZP) not yet
// KvK-registered. This is not legal advice — have a professional review it if
// you want full certainty (see the note at the end).
// Section order is client-first: FAQ and booking/shoot terms (what a client
// actually comes here to check) before the more formal/compliance sections
// (business details, privacy, cookies, terms of use).
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const updated = '22 July 2026';
const title = 'Legal, privacy & FAQ — SNAPSBYROSA';
const description = 'FAQ, booking & shoot terms, business details, privacy policy (GDPR/AVG) and cookie information for SNAPSBYROSA, The Hague.';
---
<Layout title={title} description={description} path="/legal" theme="light">
  <a href="#main" class="skip-link">Skip to content</a>
  <Nav light />
  <main id="main" class="legal">
    <div class="container">
      <header class="legal__head">
        <a class="legal__back" href="/"><span aria-hidden="true">←</span> Back to site</a>
        <h1 class="legal__title condensed">Legal, privacy &amp; FAQ</h1>
        <p class="legal__updated">Last updated: {updated}</p>
      </header>

      <div class="legal__layout">
        <nav class="legal__sidebar" aria-label="On this page">
          <a href="#faq">FAQ</a>
          <a href="#booking">Booking &amp; shoot terms</a>
          <a href="#business">Business details</a>
          <a href="#privacy">Privacy policy</a>
          <a href="#cookies">Cookies</a>
          <a href="#terms">Terms of use</a>
        </nav>

        <div class="legal__content">
          <!-- 1. FAQ -->
          <section class="legal__sec" id="faq">
            <h2>FAQ</h2>
            <div class="legal__faq">
              <details>
                <summary>Do I get the RAW files?</summary>
                <p>No. You receive the finished, edited files only. RAW files aren't part of any package.</p>
              </details>
              <details>
                <summary>How does payment work?</summary>
                <p>50% deposit to confirm your booking (non-refundable, reserves the date), and the remaining 50% before the final files are released. Full breakdown under Booking &amp; shoot terms below.</p>
              </details>
              <details>
                <summary>Who owns the copyright?</summary>
                <p>SNAPSBYROSA retains copyright over everything shot and edited. You get a licence to use the delivered files for what's agreed in your quote — your website, social media, personal or company promotion.</p>
              </details>
              <details>
                <summary>Can I use the photos for my own business or website?</summary>
                <p>Yes, for whatever's agreed in your quote — your website, social media, personal or company promotion. Anything beyond that, like reselling the images or licensing them to a third party, needs written agreement from SNAPSBYROSA first.</p>
              </details>
              <details>
                <summary>Can I edit or apply filters to the photos myself?</summary>
                <p>Please don't heavily edit, filter, or alter the photos before sharing them — a simple crop or resize for a platform is fine. This keeps the work representing the style you booked, and it's also your right (and mine) under Dutch copyright law (Auteurswet art. 25) to object to changes that alter the character of the work.</p>
              </details>
              <details>
                <summary>How do I need to credit you on social media?</summary>
                <p>Tag @snapsbyrosa in the post, or credit SNAPSBYROSA in the caption — "shot by @snapsbyrosa" works fine. No credit is needed on your own website unless otherwise agreed.</p>
              </details>
              <details>
                <summary>How long until I get my photos?</summary>
                <p>Turnaround depends on the shoot and is stated in your quote. Rush delivery is available for an extra fee if you need it faster.</p>
              </details>
              <details>
                <summary>What happens if I don't pay the balance?</summary>
                <p>The full-resolution files stay locked, and the licence to use them doesn't start, until the balance is paid.</p>
              </details>
              <details>
                <summary>What if I need to cancel or move the shoot?</summary>
                <p>The deposit is non-refundable either way. Cancel more than 7 days out and nothing further is owed. Inside 7 days, 50% of the remaining fee is due. Rescheduling once, for free, is fine with more than 48 hours' notice.</p>
              </details>
              <details>
                <summary>Will my photos show up on your portfolio or social media?</summary>
                <p>Some of the best shots from your session may be featured in my portfolio or on social media. If you'd rather they weren't, just let me know by text and they'll be left out.</p>
              </details>
            </div>
          </section>

          <!-- 2. BOOKING & SHOOT TERMS (client policy) -->
          <section class="legal__sec" id="booking">
            <h2>Booking &amp; shoot terms</h2>
            <p>
              These are the standard terms for working together. For a specific project,
              the exact scope, price and usage rights are set out in your quote — that quote,
              together with these terms, is our agreement. If the two ever conflict, the quote wins.
            </p>

            <h3>Booking &amp; deposit</h3>
            <p>
              A date is only reserved once you've confirmed the quote in writing and paid the
              deposit. The deposit is <strong>50% of the fee</strong> and is non-refundable.
              The remaining 50% (the balance) is due as set out below.
            </p>

            <h3>Payment</h3>
            <ul>
              <li><strong>How:</strong> by bank transfer or iDEAL to the details on the quote.</li>
              <li><strong>When:</strong> 50% deposit to confirm the booking; the remaining 50%
                (the balance) is due <strong>before the final files are released</strong>.</li>
              <li><strong>How delivery works:</strong> after the shoot you receive a watermarked
                preview of the edited content. Once the balance is paid, the full-resolution files
                are unlocked — usually quickly, though not always instantly.</li>
              <li><strong>For retainers:</strong> invoiced monthly in advance, payable within 14 days.</li>
              <li><strong>VAT (btw):</strong> prices are net; no VAT is charged.</li>
            </ul>

            <h3>If a payment isn't made</h3>
            <p>
              Full-resolution files, and the licence to use them, are released only once the
              balance is paid in full. For any other overdue payment (a retainer, for example),
              one reminder is sent with a short new deadline; if it's still not paid, statutory
              interest and reasonable collection costs may be added, as allowed under Dutch law.
            </p>

            <h3>Cancelling or moving a shoot</h3>
            <ul>
              <li>The deposit is non-refundable in all cases.</li>
              <li>Cancel <strong>more than 7 days</strong> before the shoot: nothing further is owed
                beyond the deposit.</li>
              <li>Cancel <strong>within 7 days</strong>: 50% of the remaining fee is due.</li>
              <li>Rescheduling is fine once, free of charge, with more than 48 hours' notice and
                a new date within 3 months.</li>
              <li>Outdoor shoots may be moved for bad weather at no cost, by agreement.</li>
              <li>If SNAPSBYROSA ever has to cancel (illness, emergency), you get a full refund
                including the deposit, or a new date — your choice.</li>
            </ul>

            <h3>Copyright &amp; how you can use the content</h3>
            <p>
              Under Dutch copyright law (Auteurswet) SNAPSBYROSA holds the copyright to everything
              shot and edited, and retains it. On full payment you receive a <strong>licence to use
              the delivered content</strong> for the purpose agreed in your quote — for example your
              website, social media and personal or company promotion. Anything beyond that
              (reselling the images, licensing them on, or use by a third party) needs written
              agreement from SNAPSBYROSA first.
            </p>

            <h3>Credit &amp; tagging</h3>
            <p>
              When you post the content on social media, please credit <strong>@snapsbyrosa</strong>
              in one of these ways:
            </p>
            <ul>
              <li>a credit in the caption or description — for example
                "shot by @snapsbyrosa", "photos by @snapsbyrosa", or just "@snapsbyrosa"; or</li>
              <li>tag @snapsbyrosa directly in the first photo or video of the post.</li>
            </ul>
            <p>
              As the maker, SNAPSBYROSA has the right to be named (persoonlijkheidsrecht, Auteurswet
              art. 25). A credit on your own website isn't required unless otherwise agreed.
            </p>

            <h3>Showing the work</h3>
            <p>
              SNAPSBYROSA shows delivered work in its portfolio and on its own social media. If
              a shoot is private or sensitive and you'd rather it wasn't shown, say so in writing
              and it will be left out.
            </p>

            <h3>People in the picture (portretrecht)</h3>
            <p>
              By booking, you confirm you're happy to be photographed and filmed and for the content
              to be used as agreed. If other identifiable people appear in the shoot, it's your
              responsibility to make sure they agree to be photographed and shown too.
            </p>

            <h3>Delivery, edits &amp; RAW files</h3>
            <ul>
              <li>Turnaround and the number of final images/edits are agreed per project and stated
                in your quote — it depends on the scope of the shoot.</li>
              <li><strong>Rush delivery</strong> (faster than the agreed turnaround) is available on
                request for an additional fee, quoted before the shoot.</li>
              <li>Editing and image selection follow SNAPSBYROSA's own style and discretion. One
                round of minor tweaks is included; larger changes are quoted separately.</li>
              <li><strong>RAW (unedited) files are not delivered.</strong> You receive the finished,
                edited files only.</li>
            </ul>

            <h3>Storing your content</h3>
            <p>
              SNAPSBYROSA keeps a backup of your delivered files for <strong>up to 3 months</strong>
              after delivery. After that there's no obligation to keep them — save your own copy.
              Files can be deleted sooner on request. Invoices are kept for 7 years to meet Dutch
              tax rules (see the privacy policy).
            </p>

            <h3>Liability</h3>
            <p>
              If something goes wrong beyond SNAPSBYROSA's control (equipment failure, illness,
              data loss, force majeure), liability is limited to the fee paid for that shoot.
              SNAPSBYROSA is not liable for indirect losses.
            </p>
          </section>

          <!-- 3. IMPRINT / COLOFON -->
          <section class="legal__sec" id="business">
            <h2>Business details</h2>
            <p>This website is run by:</p>
            <ul class="legal__facts">
              <li><span>Trade name</span> SNAPSBYROSA</li>
              <li><span>Owner</span> Jeremy Jordan Rosa</li>
              <li><span>Based in</span> The Hague, Netherlands</li>
              <li><span>Email</span> <a href="mailto:info@snapsbyrosa.com">info@snapsbyrosa.com</a></li>
              <li><span>Phone</span> <a href="tel:+31641592658">+31 6 41592658</a></li>
            </ul>
          </section>

          <!-- 4. PRIVACY POLICY -->
          <section class="legal__sec" id="privacy">
            <h2>Privacy policy</h2>
            <p>
              What personal data SNAPSBYROSA collects, why, and your rights under
              the GDPR (in Dutch, the AVG):
            </p>

            <h3>What is collected and why</h3>
            <ul>
              <li>
                <strong>When you use the enquiry form:</strong> your project details, the
                way you want to be contacted, and — if you choose Google Meet — your email
                address. This is used only to reply to you and plan the work. Legal basis:
                steps taken at your request before entering into an agreement.
              </li>
              <li>
                <strong>When you message on WhatsApp:</strong> your message and phone number
                reach SNAPSBYROSA through WhatsApp. WhatsApp's own privacy terms apply to that chat.
              </li>
              <li>
                <strong>Visit statistics (only if you accept cookies):</strong> anonymised
                data about pages viewed and rough location. No advertising, no cross-site
                tracking. Legal basis: your consent, which you can withdraw at any time.
              </li>
            </ul>

            <h3>Who processes it</h3>
            <p>Service providers used to run this site:</p>
            <ul>
              <li><strong>Hosting:</strong> GitHub Pages serves the website; Porkbun handles the domain and email forwarding.</li>
              <li><strong>Web3Forms / email:</strong> delivers enquiry-form messages to the SNAPSBYROSA inbox.</li>
              <li><strong>Google Analytics:</strong> visit statistics, only after you accept cookies.</li>
            </ul>

            <h3>How long data is kept</h3>
            <p>
              Enquiry and project correspondence is kept for as long as needed to do the
              work and to meet Dutch tax record-keeping rules (invoices: 7 years). Anything
              not needed is deleted. Analytics data is retained per Google's settings.
            </p>

            <h3>Your rights</h3>
            <p>
              You can ask to see, correct, or delete the personal data SNAPSBYROSA holds about
              you, or object to its use. Email <a href="mailto:info@snapsbyrosa.com">info@snapsbyrosa.com</a>
              for a response within 30 days. You can also complain to the Dutch Data
              Protection Authority (Autoriteit Persoonsgegevens, autoriteitpersoonsgegevens.nl).
            </p>
          </section>

          <!-- 5. COOKIES -->
          <section class="legal__sec" id="cookies">
            <h2>Cookies</h2>
            <p>
              This site does not set any tracking cookies unless you accept them. On your
              first visit you're asked once. If you accept, Google Analytics places cookies
              to count visits; if you decline, nothing is set. You can change your mind by
              clearing this site's data in your browser, which brings the choice back.
            </p>
          </section>

          <!-- 6. TERMS OF USE -->
          <section class="legal__sec" id="terms">
            <h2>Terms of use</h2>
            <p>
              All photography, video and design on this site is created by and belongs to
              SNAPSBYROSA (© {new Date().getFullYear()} Jeremy Jordan Rosa). You may not copy,
              reuse, or republish it without written permission.
            </p>
            <p>
              The site is provided as it is, and its content is for general information. It's
              not advice to rely on for decisions without independent confirmation first.
              Terms for a specific project (scope, usage rights, payment) are agreed
              separately in a quote or contract before work begins.
            </p>
            <p>Dutch law applies to this website and any dispute is subject to the Dutch courts.</p>
          </section>
        </div>
      </div>

      <p class="legal__disclaimer">
        Note: this page is a clear, standard baseline — not formal legal advice. Before you
        rely on it commercially, have it, plus your project terms (algemene voorwaarden),
        checked once by a professional.
      </p>
    </div>
  </main>
  <Footer light />
</Layout>

<style>
  .legal { padding-top: clamp(6rem, 12vw, 9rem); padding-bottom: clamp(3rem, 7vw, 5rem); }

  .legal__head { max-width: 760px; margin-bottom: clamp(2rem, 5vw, 3rem); }
  .legal__back {
    display: inline-flex; gap: 0.45rem; font-size: 0.85rem; font-weight: 600;
    color: var(--muted); margin-bottom: 1rem; transition: color 0.3s var(--ease);
  }
  .legal__back:hover { color: var(--red); }
  .legal__title { font-size: clamp(2.2rem, 7vw, 4.5rem); line-height: 0.95; }
  .legal__updated { color: var(--muted); font-size: 0.9rem; margin-top: 0.6rem; }


  /* ---------- Sidebar + content layout ---------- */
  .legal__layout {
    display: grid;
    grid-template-columns: 200px minmax(0, 760px);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .legal__sidebar {
    position: sticky;
    top: 6.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    font-size: 0.85rem;
    font-weight: 600;
    padding-right: 1rem;
    border-right: 1px solid var(--line);
  }
  .legal__sidebar a { color: var(--muted); transition: color 0.3s var(--ease); }
  .legal__sidebar a:hover { color: var(--red); }

  .legal__content { min-width: 0; }

  .legal__sec { margin-bottom: clamp(2.5rem, 6vw, 4rem); }
  .legal__sec h2 {
    font-family: var(--font-display); font-size: clamp(1.5rem, 3.5vw, 2.2rem);
    letter-spacing: -0.02em; margin-bottom: 1rem; scroll-margin-top: 6.5rem;
  }
  .legal__sec h3 {
    font-size: 1.05rem; font-weight: 700; margin: 1.75rem 0 0.6rem;
  }
  .legal__sec p { color: var(--ink-soft); line-height: 1.65; margin-bottom: 1rem; max-width: 68ch; }
  .legal__sec ul { margin: 0 0 1rem 0; padding-left: 1.2rem; display: flex; flex-direction: column; gap: 0.6rem; }
  .legal__sec li { color: var(--ink-soft); line-height: 1.6; }
  .legal__sec a { color: var(--red); text-decoration: underline; text-underline-offset: 3px; }

  .legal__facts { list-style: none; padding-left: 0; }
  .legal__facts li { display: flex; flex-wrap: wrap; gap: 0.5rem; border-top: 1px solid var(--line); padding-top: 0.6rem; }
  .legal__facts span { min-width: 200px; font-weight: 600; color: var(--ink); }

  /* ---------- FAQ ---------- */
  .legal__faq { display: flex; flex-direction: column; }
  .legal__faq details {
    border-top: 1px solid var(--line);
    padding-block: 1rem;
  }
  .legal__faq details:last-child { border-bottom: 1px solid var(--line); }
  .legal__faq summary {
    cursor: pointer;
    font-weight: 700;
    font-size: 1rem;
    color: var(--ink);
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .legal__faq summary::-webkit-details-marker { display: none; }
  .legal__faq summary::after {
    content: "+";
    font-size: 1.3rem;
    font-weight: 400;
    color: var(--red);
    transition: transform 0.3s var(--ease);
    flex-shrink: 0;
  }
  .legal__faq details[open] summary::after { transform: rotate(45deg); }
  .legal__faq summary:hover { color: var(--red); }
  .legal__faq details p { margin-top: 0.75rem; margin-bottom: 0; color: var(--ink-soft); line-height: 1.6; max-width: 68ch; }

  .legal__disclaimer {
    max-width: 760px;
    font-size: 0.9rem; color: var(--muted); background: var(--paper);
    border-left: 3px solid var(--red); padding: 0.9rem 1.1rem; border-radius: 4px;
    line-height: 1.6; margin-top: clamp(2rem, 5vw, 3rem);
  }

  @media (max-width: 900px) {
    .legal__layout { grid-template-columns: 1fr; }
    .legal__sidebar {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.5rem 1.5rem;
      border-right: none;
      border-bottom: 1px solid var(--line);
      padding-right: 0;
      padding-bottom: 1rem;
      margin-bottom: 0.5rem;
    }
  }

  @media (max-width: 520px) {
    .legal__facts span { min-width: 0; width: 100%; }
  }
</style>
